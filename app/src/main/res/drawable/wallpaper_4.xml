<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="1080dp"
    android:height="1920dp"
    android:viewportWidth="1080"
    android:viewportHeight="1920">

    <path android:pathData="M0,0h1080v1920h-1080z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="180"
                android:endX="0"
                android:endY="960"
                android:startX="1080"
                android:startY="960"
                android:type="linear">
                <item android:color="#FF100E17" android:offset="0.0" />
                <item android:color="#FF1F1A30" android:offset="0.5" />
                <item android:color="#FF0D0B14" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Deep Blue Violet Glow -->
    <path android:pathData="M 200,800 m -400,0 a 400,400 0 1,0 800,0 a 400,400 0 1,0 -800,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="200"
                android:centerY="800"
                android:gradientRadius="400"
                android:type="radial">
                <item android:color="#80654EA3" android:offset="0.0" />
                <item android:color="#00EAAFC8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pink Pastel Glow -->
    <path android:pathData="M 850,1100 m -400,0 a 400,400 0 1,0 800,0 a 400,400 0 1,0 -800,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="850"
                android:centerY="1100"
                android:gradientRadius="400"
                android:type="radial">
                <item android:color="#80EAAFC8" android:offset="0.0" />
                <item android:color="#00654EA3" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
